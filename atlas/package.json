{
  "name": "sphota-atlas",
  "private": true,
  "version": "1.0.0",
  "description": "Meaning Atlas: a zoomable map of the Sphota s1 coordinate space with in-browser encoding.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "deploy:pages": "npm run build && npx gh-pages -d dist",
    "deploy:hf": "npm run build && bash ../scripts/deploy_atlas_hf.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
